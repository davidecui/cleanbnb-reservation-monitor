# Execution Mode (local or cloud)
APP_ENV=local

# State Backend (file or firestore)
STATE_BACKEND=file

# CleanBnB Credentials
CLEANBNB_USERNAME=your_username
CLEANBNB_PASSWORD=your_password
CLEANBNB_PROPERTY_ID=your_property_id

# Lookback / Lookahead logic
RESERVATION_LOOKBACK_DAYS=30
RESERVATION_LOOKAHEAD_DAYS=365

# SMTP Email Notification (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TO=notification_recipient@example.com

# Telegram Notification (optional)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# GCP settings (used mostly in cloud mode)
# GCP_PROJECT=your-gcp-project-id
